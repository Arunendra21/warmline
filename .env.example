# WarmLine runs with NO key at all (built-in offline companion).
# Add one of these for real conversational intelligence, then restart.
# Free providers (Groq, Gemini) take priority if set.

# --- FREE, no credit card: Groq (recommended) ---  https://console.groq.com
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-20b

# --- FREE, no credit card: Google Gemini ---  https://aistudio.google.com/apikey
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.0-flash

# --- Paid: Anthropic / Claude ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Paid: OpenAI ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Optional
# PORT=3000
